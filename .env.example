# Copy this file to .env and fill in what you need.
# Never commit the real .env file — it's already in .gitignore.

# "ollama" (local, free, requires https://ollama.com installed and a model pulled)
# or "groq" / "hf" (free-tier hosted API — requires an API key below)
GENERATION_BACKEND=ollama

# Only needed if GENERATION_BACKEND is "groq" or "hf"
GROQ_API_KEY=
HF_API_KEY=
